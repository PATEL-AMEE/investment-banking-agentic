  "agent_specifications": {
    "agents": [
      {
        "agent_id": "AGENT_COMPLIANCE_001",
        "agent_name": "Compliance Check Agent",
        "agent_type": "state_graph",
        "description": "Validates documents against compliance policies and determines approval/rejection",
        "version": "1.0.0",
        "language_model": {
          "model_name": "gpt-4",
          "model_version": "0613",
          "deployment_name": "gpt4-prod",
          "max_tokens": 2000,
          "temperature": 0.3,
          "cost_per_token": {
            "input": 0.00003,
            "output": 0.0001
          }
        },
        "workflow": {
          "entry_point": "validate_request",
          "nodes": [
            {
              "node_id": "validate_request",
              "node_type": "function",
              "description": "Validate input schema and rate limits",
              "timeout_seconds": 5,
              "retry_count": 0,
              "next_nodes": ["retrieve_policies"]
            },
            {
              "node_id": "retrieve_policies",
              "node_type": "tool_call",
              "description": "Query Neo4j for applicable compliance policies",
              "tool_name": "graph_retriever",
              "timeout_seconds": 30,
              "retry_count": 3,
              "cache_enabled": true,
              "cache_ttl_seconds": 3600,
              "next_nodes": ["extract_entities"]
            },
            {
              "node_id": "extract_entities",
              "node_type": "tool_call",
              "description": "Extract entities and relationships from document",
              "tool_name": "document_analyzer",
              "timeout_seconds": 60,
              "retry_count": 2,
              "next_nodes": ["evaluate_rules"]
            },
            {
              "node_id": "evaluate_rules",
              "node_type": "tool_call",
              "description": "Apply deterministic compliance rules",
              "tool_name": "rule_evaluator",
              "timeout_seconds": 10,
              "retry_count": 1,
              "next_nodes": ["generate_decision"]
            },
            {
              "node_id": "generate_decision",
              "node_type": "llm_call",
              "description": "Generate structured compliance decision",
              "timeout_seconds": 45,
              "retry_count": 2,
              "prompt_template": "compliance_decision_generation_v1",
              "next_nodes": ["review_gate"]
            },
            {
              "node_id": "review_gate",
              "node_type": "decision",
              "description": "Determine if human review required",
              "conditions": [
                {
                  "condition": "risk_score > 4.0 OR confidence < 0.85",
                  "next_node": "route_to_review"
                },
                {
                  "condition": "else",
                  "next_node": "persist_audit"
                }
              ]
            },
            {
              "node_id": "route_to_review",
              "node_type": "tool_call",
              "description": "Route high-risk decision to human reviewer",
              "tool_name": "kafka_publish",
              "timeout_seconds": 10,
              "retry_count": 5,
              "next_nodes": ["persist_audit"]
            },
            {
              "node_id": "persist_audit",
              "node_type": "tool_call",
              "description": "Log decision to immutable audit trail",
              "tool_name": "audit_logger",
              "timeout_seconds": 5,
              "retry_count": 3,
              "next_nodes": ["publish_result"]
            },
            {
              "node_id": "publish_result",
              "node_type": "tool_call",
              "description": "Publish decision to Kafka topic",
              "tool_name": "kafka_publish",
              "timeout_seconds": 10,
              "retry_count": 5,
              "next_nodes": []
            }
          ]
        },
        "state_schema": {
          "request_id": "str",
          "user_id": "str",
          "client_id": "str",
          "document_ids": "list[str]",
          "retrieved_policies": "list[dict]",
          "extracted_entities": "dict",
          "rule_violations": "list[dict]",
          "decision": "str",
          "risk_score": "float",
          "confidence_score": "float",
          "requires_review": "bool",
          "provenance": "list[dict]",
          "audit_events": "list[dict]"
        },
        "tools_used": [
          "graph_retriever",
          "document_analyzer",
          "rule_evaluator",
          "kafka_publish",
          "audit_logger"
        ],
        "performance_targets": {
          "latency_p99_ms": 5000,
          "throughput_per_hour": 600,
          "accuracy_percent": 95
        },
        "error_handling": {
          "on_timeout": "escalate_to_review",
          "on_invalid_input": "return_400_error",
          "on_policy_not_found": "use_fallback_policy"
        }
      },
      {
        "agent_id": "AGENT_ONBOARDING_001",
        "agent_name": "Client Onboarding Agent",
        "agent_type": "state_graph",
        "description": "Orchestrates KYC/AML onboarding workflow",
        "version": "1.0.0",
        "language_model": {
          "model_name": "gpt-4",
          "model_version": "0613",
          "deployment_name": "gpt4-prod",
          "max_tokens": 2500,
          "temperature": 0.2
        },
        "workflow": {
          "entry_point": "parse_kyc_input",
          "nodes": [
            {
              "node_id": "parse_kyc_input",
              "node_type": "function",
              "description": "Normalize and validate KYC input data",
              "timeout_seconds": 10,
              "next_nodes": ["retrieve_regulations"]
            },
            {
              "node_id": "retrieve_regulations",
              "node_type": "tool_call",
              "description": "Query Neo4j for KYC/AML regulations",
              "tool_name": "graph_retriever",
              "timeout_seconds": 30,
              "next_nodes": ["check_sanctions"]
            },
            {
              "node_id": "check_sanctions",
              "node_type": "tool_call",
              "description": "Screen client and beneficial owners against sanctions lists",
              "tool_name": "sanctions_check",
              "timeout_seconds": 20,
              "retry_count": 2,
              "next_nodes": ["analyze_pep"]
            },
            {
              "node_id": "analyze_pep",
              "node_type": "llm_call",
              "description": "Perform PEP analysis on beneficial owners",
              "timeout_seconds": 30,
              "next_nodes": ["assess_risk"]
            },
            {
              "node_id": "assess_risk",
              "node_type": "function",
              "description": "Calculate AML risk score and tier",
              "timeout_seconds": 15,
              "next_nodes": ["generate_profile"]
            },
            {
              "node_id": "generate_profile",
              "node_type": "llm_call",
              "description": "Generate client compliance profile",
              "timeout_seconds": 40,
              "next_nodes": ["escalate_if_needed"]
            },
            {
              "node_id": "escalate_if_needed",
              "node_type": "decision",
              "description": "Determine if human review required",
              "conditions": [
                {
                  "condition": "risk_score >= 5.0 OR sanctions_match OR pep_found",
                  "next_node": "route_to_escalation"
                },
                {
                  "condition": "else",
                  "next_node": "persist_record"
                }
              ]
            },
            {
              "node_id": "route_to_escalation",
              "node_type": "tool_call",
              "description": "Route to human reviewer queue",
              "tool_name": "kafka_publish",
              "timeout_seconds": 10,
              "next_nodes": ["persist_record"]
            },
            {
              "node_id": "persist_record",
              "node_type": "tool_call",
              "description": "Persist onboarded client to Neo4j",
              "tool_name": "audit_logger",
              "timeout_seconds": 15,
              "next_nodes": []
            }
          ]
        },
        "state_schema": {
          "request_id": "str",
          "client_id": "str",
          "kyc_data": "dict",
          "aml_risk_score": "float",
          "beneficial_owners": "list[dict]",
          "sanctions_check": "dict",
          "pep_found": "bool",
          "risk_tier": "str",
          "final_status": "str",
          "provenance": "list[dict]"
        },
        "tools_used": [
          "graph_retriever",
          "sanctions_check",
          "kafka_publish",
          "audit_logger"
        ]
      },
