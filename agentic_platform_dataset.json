  "compliance_policies": {
    "policies": [
      {
        "policy_id": "POLICY_KYC_001",
        "policy_name": "Know Your Customer (KYC) Requirements - Corporate Clients",
        "policy_type": "regulatory",
        "issuer": "FCA",
        "effective_date": "2023-01-01T00:00:00Z",
        "version": "3.2.1",
        "status": "active",
        "jurisdiction": ["GB", "EU"],
        "regulatory_domains": ["kyc_aml", "mifid_ii"],
        "policy_text": "All corporate clients must provide: 1) Articles of Association, 2) Board Resolution, 3) Directors' identification, 4) Beneficial ownership disclosure (>25%), 5) Source of funds documentation, 6) Business purpose statement.",
        "key_requirements": [
          {
            "requirement_id": "KYC_REQ_001",
            "requirement": "Verify beneficial ownership for all entities >25%",
            "frequency": "annual",
            "evidence_type": "beneficial_ownership_registry",
            "confidence_threshold": 0.95
          },
          {
            "requirement_id": "KYC_REQ_002",
            "requirement": "Obtain source of funds documentation",
            "frequency": "on_boarding",
            "evidence_type": "bank_statement",
            "confidence_threshold": 0.90
          },
          {
            "requirement_id": "KYC_REQ_003",
            "requirement": "Perform sanctions screening (OFAC, EU, HMT)",
            "frequency": "continuous",
            "evidence_type": "sanctions_check",
            "confidence_threshold": 1.0
          }
        ],
        "related_regulations": ["REGULATION_MIFID_II_001", "REGULATION_GDPR_001"],
        "escalation_criteria": {
          "high_risk_jurisdictions": ["IR", "SY", "KP"],
          "high_risk_industries": ["weapons", "narcotics", "human_trafficking"],
          "high_transaction_value_threshold_usd": 10000000,
          "pep_detected": true,
          "sanctions_match": true
        },
        "approval_chain": [
          {
            "level": 1,
            "role": "kyc_analyst",
            "max_decision_value_usd": 1000000,
            "sla_hours": 24
          },
          {
            "level": 2,
            "role": "kyc_manager",
            "max_decision_value_usd": 5000000,
            "sla_hours": 48
          },
          {
            "level": 3,
            "role": "risk_director",
            "max_decision_value_usd": null,
            "sla_hours": 72
          }
        ],
        "audit_trail": {
          "created_by": "policy_admin_001",
          "created_at": "2023-01-01T00:00:00Z",
          "last_modified_by": "policy_admin_001",
          "last_modified_at": "2024-07-15T10:30:00Z",
          "change_log": [
            {
              "version": "3.2.0",
              "change": "Reduced beneficial ownership disclosure threshold from 30% to 25%",
              "reason": "FATF Recommendation update",
              "effective_date": "2024-07-15T00:00:00Z"
            }
          ]
        }
      },
      {
        "policy_id": "POLICY_SANCTIONS_001",
        "policy_name": "Sanctions Screening and Enforcement",
        "policy_type": "regulatory",
        "issuer": "HMT",
        "effective_date": "2022-06-01T00:00:00Z",
        "version": "2.1.0",
        "status": "active",
        "jurisdiction": ["GB", "US", "EU"],
        "regulatory_domains": ["sanctions_screening"],
        "policy_text": "All clients and beneficial owners must be screened against UK, US OFAC, EU, and UN sanctions lists. Transactions must be blocked if any match is found.",
        "screening_sources": [
          {
            "source_id": "OFAC",
            "source_name": "US Office of Foreign Assets Control",
            "refresh_frequency": "daily",
            "coverage_percentage": 0.98,
            "lists": ["SDN", "Non-SDN", "Iran", "Cuba"]
          },
          {
            "source_id": "EU_SANCTIONS",
            "source_name": "European Union Consolidated List",
            "refresh_frequency": "daily",
            "coverage_percentage": 0.99,
            "lists": ["Consolidated_List"]
          },
          {
            "source_id": "HMT",
            "source_name": "UK HM Treasury Sanctions List",
            "refresh_frequency": "real_time",
            "coverage_percentage": 0.99,
            "lists": ["UK_Consolidated"]
          }
        ],
        "matching_criteria": {
          "name_similarity_threshold": 0.85,
          "fuzzy_matching": true,
          "phonetic_matching": true,
          "date_of_birth_match_required": false
        },
        "escalation_criteria": {
          "match_score_gt": 0.85,
          "name_partial_match": true,
          "transaction_blocking_threshold": 0.95
        }
      },
      {
        "policy_id": "POLICY_MIFID_SUITABILITY_001",
        "policy_name": "MiFID II Suitability and Investment Services",
        "policy_type": "regulatory",
        "issuer": "FCA",
        "effective_date": "2023-01-03T00:00:00Z",
        "version": "2.0.0",
        "status": "active",
        "jurisdiction": ["EU", "GB"],
        "regulatory_domains": ["mifid_ii"],
        "policy_text": "Investment firms must assess client suitability based on knowledge, experience, financial situation, and investment objectives. Recommendations must be documented and retained.",
        "suitability_assessment": {
          "knowledge_levels": ["basic", "intermediate", "advanced"],
          "experience_categories": ["retail", "professional", "institutional"],
          "risk_tolerances": ["low", "moderate", "high", "speculative"],
          "investment_objectives": [
            "capital_preservation",
            "income_generation",
            "moderate_growth",
            "aggressive_growth",
            "speculation"
          ],
          "product_categorization": [
            {
              "product_type": "cash_equivalents",
              "risk_level": 1,
              "min_knowledge": "basic",
              "min_experience": "retail"
            },
            {
              "product_type": "bonds",
              "risk_level": 2,
              "min_knowledge": "intermediate",
              "min_experience": "retail"
            },
            {
              "product_type": "equities",
              "risk_level": 3,
              "min_knowledge": "intermediate",
              "min_experience": "retail"
            },
            {
              "product_type": "derivatives",
              "risk_level": 5,
              "min_knowledge": "advanced",
              "min_experience": "professional"
            }
          ]
        },
        "documentation_requirements": [
          "client_questionnaire",
          "suitability_assessment_form",
          "recommendation_letter",
          "acknowledgment_of_risk"
        ]
      }
    ]
  },
