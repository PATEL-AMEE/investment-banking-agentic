              "next_nodes": ["generate_response"]
            },
            {
              "node_id": "generate_response",
              "node_type": "llm_call",
              "description": "Generate grounded response with citations",
              "timeout_seconds": 30,
              "next_nodes": ["add_citations"]
            },
            {
              "node_id": "add_citations",
              "node_type": "function",
              "description": "Attach provenance and citations",
              "timeout_seconds": 5,
              "next_nodes": ["gate_output"]
