          },
          {
            "article_number": 25,
            "title": "Assessment of suitability and appropriateness",
            "requirements": [
              "Obtain information about knowledge and experience",
              "Obtain information about financial situation",
              "Assess suitability of investment"
            ]
          }
        ],
