# Local app settings
ENABLE_AZURE_AD=false

# Optional Neo4j backend.
# Leave NEO4J_URI unset/empty to use the built-in in-memory store.
# For a managed database use a Neo4j Aura connection string, e.g.
#   NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=test

# Optional Azure AD settings (used when ENABLE_AZURE_AD=true).
# These variable names must match what the app reads in app/services/azure_config.py.
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
# Optional: override the audience if it differs from the client id.
AZURE_AD_AUDIENCE=

# --- LLM provider (app/services/llm_adapter.py) ---
# Option 1: Azure OpenAI (takes precedence when endpoint + key are set)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01

# Option 2: any OpenAI-compatible endpoint, e.g. GitHub Models (free):
#   LLM_BASE_URL=https://models.github.ai/inference
#   LLM_MODEL=openai/gpt-4o-mini
#   LLM_API_KEY=github_pat_...   (fine-grained PAT with "Models: read")
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# Set LLM_MODE=mock to force deterministic offline responses.
LLM_MODE=

# Local dev RBAC (app/services/local_auth.py)
LOCAL_JWT_SECRET=
REQUIRE_AUTH=false

# Audit trail location (hash-chained JSONL)
AUDIT_LOG_PATH=

# Event bus: set to enable the Kafka backend (Redpanda via docker-compose,
# Apache Kafka, or Azure Event Hubs). Empty = in-process bus.
#   local docker-compose broker: localhost:9092
KAFKA_BOOTSTRAP_SERVERS=
# Azure Event Hubs: paste the namespace connection string and leave
# KAFKA_BOOTSTRAP_SERVERS empty — SASL_SSL auth and the bootstrap server
# (<namespace>.servicebus.windows.net:9093) are derived automatically.
KAFKA_CONNECTION_STRING=
# Other secured Kafka clusters (ignored when KAFKA_CONNECTION_STRING is set):
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Observability: print OpenTelemetry spans to the console.
OTEL_CONSOLE=false

# Vector retrieval backend (app/services/azure_search_store.py).
# Set endpoint + key to index/search the corpus on Azure AI Search (hybrid
# BM25 + vector); leave empty for the local in-memory vector store.
#   AZURE_SEARCH_ENDPOINT=https://<name>.search.windows.net
#   AZURE_SEARCH_KEY=<admin key>
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=policy-corpus
