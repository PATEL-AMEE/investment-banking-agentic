# Local app settings
ENABLE_AZURE_AD=false

# Optional Neo4j backend.
# Leave NEO4J_URI unset/empty to use the built-in in-memory store.
# For a managed database use a Neo4j Aura connection string, e.g.
#   NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=test

# Optional Azure AD settings (used when ENABLE_AZURE_AD=true).
# These variable names must match what the app reads in app/services/azure_config.py.
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
# Optional: override the audience if it differs from the client id.
AZURE_AD_AUDIENCE=

# Optional Azure OpenAI / AI Search integration (used when USE_AZURE_SERVICES=true).
USE_AZURE_SERVICES=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=policy-index
